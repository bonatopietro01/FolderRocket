# Server address used by Gmail and Outlook OAuth callbacks in private Hub mode.
# Keep localhost while working locally. Replace with the HTTPS Tailscale address
# only after Tailscale Serve has shown you the final URL.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Optional: a 64-character hexadecimal key used to encrypt per-user OAuth tokens.
# If omitted, FolderRocket creates a local private key file on first startup.
FOLDERROCKET_TOKEN_ENCRYPTION_KEY=

# Keep real values only in backend/.env (never commit or share that file).
OPENAI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
