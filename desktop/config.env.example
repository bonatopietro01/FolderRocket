# This file is a template only. Never put a real key in the project folder or in Git.
#
# After installing FolderRocket on Windows, copy these entries to:
# %APPDATA%\FolderRocket\config.env
# The desktop app reads this file locally and passes only these values to its local backend.

OPENAI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Optional. Leave blank to let FolderRocket create a private local token key.
FOLDERROCKET_TOKEN_ENCRYPTION_KEY=
