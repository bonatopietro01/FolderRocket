# Keep source files consistent across Windows and future build environments.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf

# Do not attempt line-by-line diffs for generated or binary documents.
*.xlsx binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
