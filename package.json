{
  "name": "folderrocket",
  "private": true,
  "version": "0.2.0-alpha.12",
  "description": "Local-first desktop workspace for files and document workflows.",
  "author": "Pietro Bonato",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm --prefix backend test",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "auth:reset-admin": "node scripts/reset-local-admin.cjs",
    "desktop:package": "npm run build && node scripts/package-desktop.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.bonatopietro.folderrocket",
    "productName": "FolderRocket",
    "asar": true,
    "compression": "normal",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!test{,/**}",
          "!node_modules{,/**}",
          "!data{,/**}",
          "!uploads{,/**}",
          "!.env",
          "!.folderrocket-email-tokens.json",
          "!.folderrocket-token-key"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.md",
          "!**/test{,/**}",
          "!**/tests{,/**}",
          "!**/__tests__{,/**}",
          "!**/docs{,/**}",
          "!**/example{,/**}",
          "!**/examples{,/**}"
        ]
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
